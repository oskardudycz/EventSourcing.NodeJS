{
  "name": "eventsourcing.nodejs",
  "type": "module",
  "version": "6.0.0",
  "description": "Samples of Event Sourcing in JavaScript and TypeScript",
  "engines": {
    "node": ">=24.22.1"
  },
  "scripts": {
    "setup": "cat .nvmrc | nvm install; nvm use",
    "build": "run-s lint build:ts",
    "build:ts": "tsc -b",
    "build:ts:watch": "tsc -b --watch",
    "start": "tsx ./src/index.ts",
    "lint": "npm run lint:eslint && npm run lint:prettier",
    "lint:prettier": "prettier --cache --check \"**/**/*.{json,md}\"",
    "lint:eslint": "eslint --cache \"**/*.ts\"",
    "fix": "npm run fix:eslint && npm run fix:prettier",
    "fix:prettier": "prettier --cache --write \"**/**/*.{json,md}\"",
    "fix:eslint": "eslint --cache \"**/*.ts\" --fix"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oskardudycz/EventSourcing.NodeJS.git"
  },
  "keywords": [
    "Event Sourcing"
  ],
  "author": "Oskar Dudycz",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/oskardudycz/EventSourcing.NodeJS/issues"
  },
  "homepage": "https://github.com/oskardudycz/EventSourcing.NodeJS#readme",
  "dependencies": {
    "@kurrent/kurrentdb-client": "^1.3.2",
    "express": "^5.3.0",
    "mongodb": "^7.8.0",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^17.14.0",
    "npm-run-all2": "^9.0.4",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "protobufjs@7.6.6": true,
    "ssh2@1.17.0": true,
    "cpu-features@0.0.10": true
  }
}
