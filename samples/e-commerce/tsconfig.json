{
  "extends": "./tsconfig.shared.json",
  "include": [
    "vitest.config.ts",
    "vitest.shared.ts",
    "packages/*/vitest.config.ts"
  ],
  "exclude": ["node_modules", "tmp"],
  "files": [],
  "compilerOptions": {
    "noEmit": true /* Do not emit outputs. */,
    "allowImportingTsExtensions": true
  },
  "references": [
    {
      "path": "./packages/core/"
    },
    {
      "path": "./packages/application/"
    }
  ]
}
