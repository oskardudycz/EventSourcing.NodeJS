{
  "openapi": "3.1.0",
  "info": {
    "title": "E-commerce",
    "version": "1.0.0",
    "description": "Shopping carts and orders of the e-commerce sample."
  },
  "tags": [
    {
      "name": "Shopping carts"
    }
  ],
  "components": {
    "schemas": {
      "Cart": {
        "type": "object",
        "properties": {
          "shoppingCartId": {
            "type": "string"
          },
          "customerId": {
            "type": "string"
          },
          "lines": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "productId": {
                  "type": "string"
                },
                "quantity": {
                  "type": "number"
                },
                "unitPrice": {
                  "type": "number"
                }
              },
              "required": [
                "productId",
                "quantity",
                "unitPrice"
              ]
            }
          },
          "totalPrice": {
            "type": "number"
          },
          "checkedOut": {
            "type": "boolean"
          },
          "version": {
            "type": "number"
          }
        },
        "required": [
          "shoppingCartId",
          "customerId",
          "lines",
          "totalPrice",
          "checkedOut",
          "version"
        ]
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "number"
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string"
          }
        },
        "required": [
          "status"
        ]
      },
      "ProductItem": {
        "type": "object",
        "properties": {
          "productId": {
            "type": "string",
            "description": "Id of the product"
          },
          "quantity": {
            "type": "number",
            "exclusiveMinimum": 0,
            "description": "How many to add"
          }
        },
        "required": [
          "productId",
          "quantity"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/customers/{customerId}/shopping-carts/current": {
      "get": {
        "operationId": "getCurrentShoppingCart",
        "summary": "Get the current shopping cart",
        "tags": [
          "Shopping carts"
        ],
        "x-eventcatalog-message-type": "query",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "description": "Id of the customer"
            },
            "required": true,
            "description": "Id of the customer",
            "name": "customerId",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "The cart. The ETag header holds its version.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Cart"
                }
              }
            }
          },
          "304": {
            "description": "The cart did not change since the ETag in If-None-Match"
          },
          "404": {
            "description": "The customer has no open cart",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/customers/{customerId}/shopping-carts/current/product-items": {
      "post": {
        "operationId": "addProductItem",
        "summary": "Add a product to the current shopping cart",
        "tags": [
          "Shopping carts"
        ],
        "x-eventcatalog-message-type": "command",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "description": "Id of the customer"
            },
            "required": true,
            "description": "Id of the customer",
            "name": "customerId",
            "in": "path"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProductItem"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Added. The ETag header holds the new version."
          },
          "400": {
            "description": "The body is not a product item",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      },
      "delete": {
        "operationId": "removeProductItem",
        "summary": "Remove a product from the current shopping cart",
        "tags": [
          "Shopping carts"
        ],
        "x-eventcatalog-message-type": "command",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "description": "Id of the customer"
            },
            "required": true,
            "description": "Id of the customer",
            "name": "customerId",
            "in": "path"
          },
          {
            "schema": {
              "type": "string"
            },
            "required": true,
            "name": "productId",
            "in": "query"
          },
          {
            "schema": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "required": true,
            "name": "quantity",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "description": "Weak ETag with the cart version, such as W/\"3\""
            },
            "required": true,
            "description": "Weak ETag with the cart version, such as W/\"3\"",
            "name": "If-Match",
            "in": "header"
          }
        ],
        "responses": {
          "200": {
            "description": "Removed. The ETag header holds the new version."
          },
          "400": {
            "description": "The product or the If-Match header is not valid",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "The customer has no open cart",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "The cart does not have this product item",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "412": {
            "description": "The cart version changed",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/customers/{customerId}/shopping-carts/current/checkout": {
      "post": {
        "operationId": "checkOutShoppingCart",
        "summary": "Check out the current shopping cart",
        "tags": [
          "Shopping carts"
        ],
        "x-eventcatalog-message-type": "command",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "description": "Id of the customer"
            },
            "required": true,
            "description": "Id of the customer",
            "name": "customerId",
            "in": "path"
          },
          {
            "schema": {
              "type": "string",
              "description": "Weak ETag with the cart version, such as W/\"3\""
            },
            "required": true,
            "description": "Weak ETag with the cart version, such as W/\"3\"",
            "name": "If-Match",
            "in": "header"
          }
        ],
        "responses": {
          "202": {
            "description": "Accepted. The Location header points to the order that follows."
          },
          "409": {
            "description": "Prices changed. Read the cart and check out again.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "412": {
            "description": "The cart version changed",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    }
  },
  "webhooks": {}
}