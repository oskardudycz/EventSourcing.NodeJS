      }
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "Subscription lag",
      "description": "How long after its append each subscription handled an event: the 95th percentile and the worst case. A growing lag means a subscription falls behind its events, for example because a handler fails and is retried.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 39,
        "w": 24,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["mean", "max"]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, messaging_destination_name) (rate(messaging_lag_milliseconds_bucket[$__rate_interval])))",
          "legendFormat": "p95 {{messaging_destination_name}}",
          "range": true,
          "instant": false
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (messaging_destination_name) (rate(messaging_lag_milliseconds_sum[$__rate_interval]) / rate(messaging_lag_milliseconds_count[$__rate_interval]))",
          "legendFormat": "max {{messaging_destination_name}}",
          "range": true,
          "instant": false
        }
      ]
    },
