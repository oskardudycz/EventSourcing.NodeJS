    {
      "id": 6,
      "type": "timeseries",
      "title": "Orders by outcome",
      "description": "How orders move: placed, confirmed (payment authorized and stock reserved), completed, canceled or closed unpaid.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "custom": {
            "drawStyle": "bars",
