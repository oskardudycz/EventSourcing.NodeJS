        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (emmett_event_type) (increase(emmett_event_appending_count_total{emmett_event_type=~\"orders.OrderPlaced|orders.OrderConfirmed|orders.OrderCompleted|orders.OrderCanceled|orders.OrderClosedUnpaid\"}[$__interval]))",
          "legendFormat": "{{emmett_event_type}}",
          "range": true,
          "instant": false
