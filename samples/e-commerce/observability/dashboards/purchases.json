    {
      "id": 14,
      "type": "timeseries",
      "title": "Dead letters",
      "description": "Messages a queue gave up on after its retries. They wait in the queue's dead-letter topic or queue.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 31,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (messaging_destination_name, message_type) (increase(messaging_dead_lettered_total[$__interval]))",
          "legendFormat": "{{messaging_destination_name}} {{message_type}}",
          "range": true,
          "instant": false
        }
      ],
      "interval": "1m",
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["sum"]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Failed message handlers",
      "description": "Kafka and RabbitMQ listener calls that threw. The bus retries them, then dead-letters them.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 31,
        "w": 12,
