{
  "uid": "e-commerce-purchases",
  "title": "E-commerce purchases",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Orders in progress",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(ecommerce_orders_in_progress)",
          "legendFormat": "__auto"
        }
      ]
    },
    {
      "id": 2,
      "title": "Orders awaiting payment",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(ecommerce_orders_awaiting_payment)",
          "legendFormat": "__auto"
        }
      ]
    },
    {
      "id": 3,
      "title": "Revenue per hour",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(ecommerce_order_revenue_sum[1h]))",
          "legendFormat": "__auto"
        }
      ]
    },
    {
      "id": 4,
      "title": "Orders placed",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(emmett_event_appending_count_total{emmett_event_type=\"orders.OrderPlaced\"}[5m]))",
          "legendFormat": "__auto"
        }
      ]
    },
    {
      "id": 5,
      "title": "Lead time p95 per stage",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, ecommerce_order_stage) (rate(ecommerce_order_lead_time_bucket[5m])))",
          "legendFormat": "__auto"
        }
      ]
    },
    {
      "id": 6,
      "title": "Events appended per type",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 12
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (emmett_event_type) (increase(emmett_event_appending_count_total[5m]))",
          "legendFormat": "__auto"
        }
      ]
    },
    {
      "id": 7,
      "title": "Payment failures",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 20
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (emmett_event_type) (increase(emmett_event_appending_count_total{emmett_event_type=~\"payments.PaymentTimedOut|payments.PaymentCaptureFailed|payments.PaymentAuthorizationExpired\"}[5m]))",
          "legendFormat": "__auto"
        }
      ]
    },
    {
      "id": 8,
      "title": "Commands handled per status",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 20
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (emmett_command_status) (increase(emmett_command_handling_duration_count[5m]))",
          "legendFormat": "__auto"
        }
      ]
    },
    {
      "id": 9,
      "title": "Command duration p95",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 28
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(emmett_command_handling_duration_bucket[5m])))",
          "legendFormat": "__auto"
        }
      ]
    },
    {
      "id": 10,
      "title": "Processor duration p95",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 28
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(emmett_processor_processing_duration_bucket[5m])))",
          "legendFormat": "__auto"
        }
      ]
    },
    {
      "id": 11,
      "title": "Workflow duration p95",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 36
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(emmett_workflow_processing_duration_bucket[5m])))",
          "legendFormat": "__auto"
        }
      ]
    },
    {
      "id": 12,
      "title": "Stream appending duration p95",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 36
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(emmett_stream_appending_duration_bucket[5m])))",
          "legendFormat": "__auto"
        }
      ]
    }
  ]
}
