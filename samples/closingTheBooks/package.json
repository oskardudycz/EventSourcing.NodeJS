{
  "name": "eventsourcing.nodejs",
  "type": "module",
  "version": "6.0.0",
  "description": "Samples of Event Sourcing in JavaScript and TypeScript",
  "engines": {
    "node": ">=24.22.1"
  },
  "scripts": {
    "setup": "cat .nvmrc | nvm install; nvm use",
    "build": "npm run build:ts",
    "build:ts": "tsc -b",
    "build:ts:watch": "tsc -b --watch",
    "build:bundle": "tsdown",
    "start": "run-p start:**",
    "start:server": "tsx ./src/index.ts",
    "start:subscription": "tsx ./src/subscription.ts",
    "test:file": "vitest run --no-file-parallelism --reporter=verbose",
    "test": "npm run test:unit && npm run test:int && npm run test:api && npm run test:e2e",
    "test:unit": "vitest run unit --passWithNoTests",
    "test:int": "vitest run int --passWithNoTests",
    "test:api": "vitest run api --passWithNoTests",
    "test:e2e": "vitest run e2e --passWithNoTests",
    "lint": "npm run lint:eslint && npm run lint:prettier",
    "lint:prettier": "prettier --cache --check \"**/**/*.{json,md}\"",
    "lint:eslint": "eslint --cache \"**/*.ts\"",
    "fix": "npm run fix:eslint && npm run fix:prettier",
    "fix:prettier": "prettier --cache --write \"**/**/*.{json,md}\"",
    "fix:eslint": "eslint --cache \"**/*.ts\" --fix"
  },
  "husky": {
    "hooks": {
      "pre-commit": "npm run lint"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oskardudycz/EventSourcing.NodeJS.git"
  },
  "keywords": [
    "Event Sourcing"
  ],
  "author": "Oskar Dudycz",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/oskardudycz/EventSourcing.NodeJS/issues"
  },
  "homepage": "https://github.com/oskardudycz/EventSourcing.NodeJS#readme",
  "dependencies": {
    "@kurrent/kurrentdb-client": "^1.3.2",
    "convict": "^6.2.5",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "iter-tools-es": "^7.5.4",
    "mongodb": "^7.8.0",
    "uuid": "^14.0.3",
    "validator": "^13.15.35"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testcontainers/mongodb": "^12.2.1",
    "@types/convict": "^6.1.6",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/supertest": "^7.2.1",
    "@types/validator": "^13.15.10",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^17.14.0",
    "npm-run-all2": "^9.0.4",
    "prettier": "^3.10.1",
    "supertest": "^7.3.2",
    "testcontainers": "^12.2.1",
    "tsdown": "^0.23.7",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "protobufjs@7.6.6": true,
    "ssh2@1.17.0": true,
    "cpu-features@0.0.10": true
  }
}
