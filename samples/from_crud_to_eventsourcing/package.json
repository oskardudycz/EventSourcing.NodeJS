{
  "name": "from-crud-to-event-sourcing",
  "type": "module",
  "version": "1.0.0",
  "description": "Samples of migrating from CRUD to Event Sourcing",
  "engines": {
    "node": ">=24.22.1"
  },
  "scripts": {
    "setup": "cat .nvmrc | nvm install; nvm use",
    "build": "run-s lint build:ts",
    "build:ts": "tsc -b",
    "build:ts:watch": "tsc -b --watch",
    "lint": "run-s lint:eslint lint:prettier",
    "lint:prettier": "prettier --cache --check \"**/**/*.{json,md,sql}\"",
    "lint:eslint": "eslint --cache \"**/*.ts\"",
    "fix": "run-s fix:eslint fix:prettier",
    "fix:prettier": "prettier --cache --write \"**/**/*.{json,md,sql}\"",
    "fix:eslint": "eslint --cache \"**/*.ts\" --fix",
    "crud:start": "tsx ./src/crud/index.ts",
    "eventsourced:start": "tsx ./src/eventsourced/index.ts",
    "test:file": "vitest run --no-file-parallelism --reporter=verbose",
    "test": "run-s test:unit test:int test:api test:e2e",
    "test:unit": "vitest run unit --passWithNoTests",
    "test:int": "vitest run int --passWithNoTests",
    "test:api": "vitest run api --passWithNoTests",
    "test:e2e": "vitest run e2e --passWithNoTests"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oskardudycz/EventSourcing.NodeJS.git"
  },
  "keywords": [
    "Event Sourcing"
  ],
  "author": "Oskar Dudycz",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/oskardudycz/EventSourcing.NodeJS/issues"
  },
  "homepage": "https://github.com/oskardudycz/EventSourcing.NodeJS#readme",
  "dependencies": {
    "@event-driven-io/dumbo": "0.13.0-rc.2",
    "@event-driven-io/emmett": "0.43.0-rc.3",
    "@event-driven-io/emmett-expressjs": "0.43.0-rc.3",
    "@event-driven-io/emmett-postgresql": "0.43.0-rc.3",
    "@faker-js/faker": "^10.6.0",
    "convict": "^6.2.5",
    "dotenv": "^18.0.10",
    "dotenv-cli": "^11.1.0",
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "typeorm": "^1.1.3",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@event-driven-io/emmett-testcontainers": "0.43.0-rc.3",
    "@testcontainers/postgresql": "^12.2.1",
    "@types/convict": "^6.1.6",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^17.14.0",
    "npm-run-all2": "^9.0.4",
    "prettier": "^3.10.1",
    "prettier-plugin-sql": "^0.20.0",
    "supertest": "^7.3.2",
    "testcontainers": "^12.2.1",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "protobufjs@7.6.6": true,
    "ssh2@1.17.0": true,
    "cpu-features@0.0.10": true
  }
}
