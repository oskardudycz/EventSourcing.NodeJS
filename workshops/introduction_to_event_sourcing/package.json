{
  "name": "eventsourcing.nodejs",
  "type": "module",
  "version": "1.0.0",
  "description": "Samples of Event Sourcing in JavaScript and TypeScript",
  "engines": {
    "node": ">=24.22.1"
  },
  "scripts": {
    "setup": "cat .nvmrc | nvm install; nvm use",
    "build": "run-s lint build:ts",
    "build:ts": "tsc -b",
    "build:ts:watch": "tsc -b --watch",
    "start": "tsx ./src/index.ts",
    "lint": "npm run lint:eslint && npm run lint:prettier",
    "lint:prettier": "prettier --cache --check \"**/**/*.{json,md}\"",
    "lint:eslint": "eslint --cache \"**/*.ts\"",
    "fix": "run-s fix:eslint fix:prettier",
    "fix:prettier": "prettier --cache --write \"**/**/*.{json,md}\"",
    "fix:eslint": "eslint --cache \"**/*.ts\" --fix",
    "test:file": "vitest run --no-file-parallelism --reporter=verbose",
    "test": "run-s test:exercises test:solved test:infr",
    "test:exercises": "vitest run exercise --passWithNoTests",
    "test:solved": "vitest run solved --passWithNoTests",
    "test:infr": "vitest run infr --passWithNoTests",
    "test:watch": "vitest",
    "test:exercises:watch": "vitest exercise --passWithNoTests",
    "test:solved:watch": "vitest solved --passWithNoTests"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oskardudycz/EventSourcing.NodeJS.git"
  },
  "keywords": [
    "Event Sourcing"
  ],
  "author": "Oskar Dudycz",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/oskardudycz/EventSourcing.NodeJS/issues"
  },
  "homepage": "https://github.com/oskardudycz/EventSourcing.NodeJS#readme",
  "dependencies": {
    "@event-driven-io/emmett": "0.43.0-rc.2",
    "@event-driven-io/emmett-esdb": "0.43.0-rc.2",
    "@event-driven-io/emmett-expressjs": "0.43.0-rc.2",
    "@event-driven-io/emmett-mongodb": "0.43.0-rc.2",
    "@event-driven-io/emmett-postgresql": "0.43.0-rc.2",
    "@eventstore/db-client": "^6.2.1",
    "@faker-js/faker": "^10.6.0",
    "dotenv": "^18.0.10",
    "dotenv-cli": "^11.1.0",
    "express": "^5.3.0",
    "http-problem-details": "^0.1.7",
    "immutable": "^5.1.10",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@event-driven-io/emmett-testcontainers": "0.43.0-rc.2",
    "@testcontainers/mongodb": "^12.2.1",
    "@testcontainers/postgresql": "^12.2.1",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^17.14.0",
    "npm-run-all2": "^9.0.4",
    "prettier": "^3.10.1",
    "supertest": "^7.3.2",
    "testcontainers": "^12.2.1",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "protobufjs@7.6.6": true,
    "ssh2@1.17.0": true,
    "cpu-features@0.0.10": true
  }
}
